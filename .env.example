# Copy to .env.local for local development against Supabase.
# Leave these unset to run purely on browser-local storage (no account needed).
#
# Project URL and anon key: Supabase dashboard -> Project Settings -> API.
# The anon key is safe to publish; row-level security is what protects the data.

VITE_SUPABASE_URL=https://yourproject.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# The single shared account staff sign in as. Create this user in
# Supabase -> Authentication -> Users -> Add user (auto-confirm the email).
# The PASSWORD is never stored in this file or in the repo — staff type it.
VITE_STAFF_EMAIL=unit-staff@example.org
